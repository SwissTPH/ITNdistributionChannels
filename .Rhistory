library(openMalariaUtilities)
library(tidyverse)
options(scipen = 999)
main_folder=("/Users/chamcl/Swiss Tropical and Public Health Institute, Swiss TPH/AIM - Methodological development/1. Vector Control/ITN_distribution_channels/")
exp_folder_combined=(file.path(main_folder, "Mosha_MassU5/v2/"))
ca_original=read.csv(file.path(exp_folder_combined,"../Mosha_InsecticideDecay/cases_averted_InsecticideDecay_correct.csv" ))%>% filter(ITNcampaign %in% c("massU5","massU5unif", "mass"))
ca=read.csv(file.path(exp_folder_combined,"cases_averted_MassU5.csv" ))
ca_EHT=read.csv(file.path(exp_folder_combined,"cases_averted_MassU5_EHT.csv" ))
all_simul_simple_year_save=read.csv(file.path(exp_folder_combined,"all_simul_simple_year_MassU5.csv" ))
ca_mean=ca %>% group_by(EIR, halflife, reach, ITNcampaign, age_group)%>%
summarise(nUncomp_averted_mean=mean(nUncomp_averted_mean),nSevere_averted_mean=mean(nSevere_averted_mean),nDirDeaths_averted_mean=mean(nDirDeaths_averted_mean))
ca_EHT_mean=ca_EHT %>% group_by(EIR, halflife, reach, ITNcampaign, age_group, EHT)%>%
summarise(nUncomp_averted_mean=mean(nUncomp_averted_mean),nSevere_averted_mean=mean(nSevere_averted_mean),nDirDeaths_averted_mean=mean(nDirDeaths_averted_mean))
ca%>% filter(histITNcov==.20, halflife %in% c(1,2,3), age_group!="0-1")%>%
mutate(coverage=reach*0.16*1.8)%>%
ggplot()+
geom_line(aes(x=coverage, y=nUncomp_averted_mean, linetype=ITNcampaign, color=as.factor(halflife)), lwd=1)+
facet_grid(age_group~EIR, scale="free")+
scale_color_manual(values=c("gold", "orange", "red"))+
theme_bw()
ca%>% filter(histITNcov==.20, halflife %in% c(1,2,3), age_group!="0-1")%>%
mutate(coverage=reach*0.16*1.8)%>%
