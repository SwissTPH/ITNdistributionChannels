main_folder=("/Users/chamcl/switchdrive/AIM/2. Methodological development/ITN_distribution_channels/")
exp_folder=(file.path(main_folder, "Mosha_full2/"))
# SET EXPERIMENT ----------------------------------------------------------
COUNTRY     = "TZA"
SIMSTART    = "1918-01-01"
versionnum  = 44L
expName  = "Mosha_ITNchannels"
experiment_folder=exp_folder
####Fitting with Clara's method
scens=read.csv(file.path(experiment_folder, "scenarios.csv"))
# PREPARE THE DATA TO FIT
# open database connection
conn = DBI::dbConnect(RSQLite::SQLite(),file.path(exp_folder,"results_RCTMosha_full_year.sqlite"))
# list the tables of the database
DBI::dbListTables(conn)
# extract the results table, this should have the same name as provided to slurmPrepareResults
all_simul_0 = DBI::dbReadTable(conn, "results")
# always disconnect from the database
DBI::dbDisconnect(conn)
head(all_simul_0)
all_simul_0_merged=all_simul_0 %>%
left_join( scens %>% rename(scenario_id=ID))
# mean over seeds and EHTs
all_simul_simple_year=merge(all_simul_0 %>% filter(age_group %in% c("0-5", "0-1", "0-100")),
scens %>% select(ID, ITNtype, EHT, ITNcampaign, halflife,histITNcov, EIR, reach, seed)%>%
rename(scenario_id=ID))%>%
group_by(date, age_group, ITNtype,  ITNcampaign, halflife,histITNcov, EIR, reach)%>%
summarise(nUncomp=mean(nUncomp), nSevere=mean(nSevere), nDirDeaths=mean(nDirDeaths), nHost=mean(nHost),
incidenceRate=mean(incidenceRate),prevalenceRate=mean(prevalenceRate) )%>%
mutate(year=substr(date, 1,4),
cases_all=1000*(nUncomp+nSevere)/nHost,casessevere=1000*(nSevere)/nHost,
deaths=1000*(nDirDeaths)/nHost)
all_simul_simple_year_save=all_simul_simple_year%>% filter(year>2014)%>%
ungroup()%>%
select(year, age_group, ITNcampaign, halflife, histITNcov, EIR, reach, cases_all, casessevere, deaths, prevalenceRate)%>%
mutate(is.unif=ifelse(stringr::str_detect(ITNcampaign, "unif") | ITNcampaign=="mass", "uniform", "age targeted")) %>%
mutate(ITNcampaign=factor(ITNcampaign, levels=c("mass", "massU5", "massU5unif","contU1", "contU1unif",  "cont6to14","cont6to14unif", "none"),
labels = c("Mass","Mass <5", "Mass <5", "Continuous <1", "Continuous <1", "Continuous 6-14", "Continuous 6-14", "None")))
View(all_simul_simple_year_save)
write.csv(all_simul_simple_year_save, file.path(experiment_folder,"all_simul_simple_year.csv" ), row.names = F)
