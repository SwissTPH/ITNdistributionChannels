source("single_channel_scenarios.R")
source("combined_channels_scenarios.R")
data=readRDS(file.path("inputs/epi_outputs.rds"))
data$max_usage=0.8
data$year=as.numeric(data$year)
data_ca=read.csv(file.path("inputs/cases_averted.csv"))%>%
mutate(halflife=as.factor(halflife),
delivery=factor(as.character(ITNcampaign),
levels=c("mass",
"massU5", "massU5unif",
"contU1", "contU1unif",
"cont6to14", "cont6to14unif"),
labels=c("Mass",
"Mass <5",
"Mass <5\nuniform",
"Continuous <1", "Continuous <1\nuniform",
"Continuous 6-14", "Continuous 6-14\nuniform")))
data_ca$max_usage=0.8
ITN_number=data.frame(delivery=unique(data_ca$delivery))%>%
mutate(nbITN=case_when(
delivery=="Mass" ~ 1/1.8,
delivery %in% c("Mass <5", "Mass <5\nuniform") ~ 0.16,
delivery %in% c("Continuous <1", "Continuous <1\nuniform")  ~ 0.035*3,
delivery %in% c("Continuous 6-14", "Continuous 6-14\nuniform")  ~ 0.27*0.5*3
)*1000)
runApp()
runApp()
runApp()
runApp()
runApp()
runApp()
runApp()
runApp()
runApp()
runApp()
ITN_number_combined=data.frame(delivery=c("Mass 3 years","Mass 5 years", "EPI","RCH","School","School in between (3)","School in between (5)"))%>%
mutate(nbITN_perYear=case_when(
delivery=="Mass 3 years" ~ 1/1.8/3,
delivery=="Mass 5 years" ~ 1/1.8/5,
delivery %in% c("EPI")  ~ 0.035,
delivery %in% c("RCH")  ~ 0.07,
delivery %in% c("School")  ~ 0.27*0.5,
delivery %in% c("School in between (3)")  ~ 0.27*0.5*2/3,
delivery %in% c("School in between (5)")  ~ 0.27*0.5*4/5
)*1000,
nbITN_3years=nbITN_perYear*3,
nbITN_5years=nbITN_perYear*5,
nbITN_15years=nbITN_perYear*15,
)
runApp()
?round
runApp()
list_channels = c("Mass 3 years")
ITN_number_combined %>% filter(delivery %in% list_channels) %>%
summarise(nbITN_3years=sum(nbITN_3years),nbITN_5years=sum(nbITN_5years),nbITN_15years=sum(nbITN_15years))%>%
pivot_longer(cols = c(nbITN_3years,nbITN_5years,nbITN_15years), names_to = "Time period", values_to = "Total number of ITNs (per 1000 people)", names_prefix = "nbITN_")%>%
mutate(across(where(is.numeric), ~ round(.)))
ITN_number_combined %>% filter(delivery %in% list_channels) %>%
summarise(nbITN_3years=sum(nbITN_3years),nbITN_5years=sum(nbITN_5years),nbITN_15years=sum(nbITN_15years))%>%
pivot_longer(cols = c(nbITN_3years,nbITN_5years,nbITN_15years), names_to = "Time period", values_to = "Total number of ITNs (per 1000 people)", names_prefix = "nbITN_") %>%
mutate(across(where(is.numeric), ~ sprintf("%.2f", .)))
ITN_number_combined %>% filter(delivery %in% list_channels) %>%
summarise(nbITN_3years=sum(nbITN_3years),nbITN_5years=sum(nbITN_5years),nbITN_15years=sum(nbITN_15years))%>%
pivot_longer(cols = c(nbITN_3years,nbITN_5years,nbITN_15years), names_to = "Time period", values_to = "Total number of ITNs (per 1000 people)", names_prefix = "nbITN_") %>%
mutate(across(where(is.numeric), ~ sprintf("%.f", .)))
runApp()
runApp()
runApp()
